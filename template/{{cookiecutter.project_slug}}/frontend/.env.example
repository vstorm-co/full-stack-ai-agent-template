# Backend API URL (server-side only - not exposed to browser)
BACKEND_URL=http://localhost:{{ cookiecutter.backend_port }}

# Send the auth cookies with the Secure flag. Unset follows NODE_ENV, so
# production means Secure — and a browser silently discards a Secure cookie
# served over plain http://, which logs you in and then 401s every request
# after it. Only set this to false for an http:// deployment on a trusted
# network; the real fix is to serve the app over TLS.
# COOKIE_SECURE=false

# WebSocket URL for the chat stream. Read by the BROWSER, so it must be an
# address the browser can reach (not a Docker service name), and because
# NEXT_PUBLIC_* is inlined at build time it has to be set before `bun run
# build` — in Docker that means a build arg, see docker-compose.frontend.yml.
NEXT_PUBLIC_WS_URL=ws://localhost:{{ cookiecutter.backend_port }}

# Public API URL, exposed to the browser (OAuth redirects, links to the API
# docs). Same build-time rule as NEXT_PUBLIC_WS_URL above.
NEXT_PUBLIC_API_URL=http://localhost:{{ cookiecutter.backend_port }}
{%- if cookiecutter.enable_rag %}

# RAG (Retrieval Augmented Generation)
NEXT_PUBLIC_RAG_ENABLED=true
{%- endif %}
{%- if cookiecutter.enable_logfire %}

# Logfire/OpenTelemetry (server-side instrumentation)
# Get your write token from: https://logfire.pydantic.dev
OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-api.pydantic.dev
OTEL_EXPORTER_OTLP_HEADERS=Authorization=your-logfire-write-token
{%- endif %}
